# Block pushes that add console.log to app code (scripts/no-console.sh).
# git passes one "<local ref> <local sha> <remote ref> <remote sha>" line per
# ref being pushed. Skip once with `git push --no-verify`, or disable all hooks
# with HUSKY=0 (CI and the release job do this).
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;; # deleting a remote branch: nothing to check
  esac
  case "$remote_sha" in
    *[!0]*) base=$remote_sha ;;
    *) base= ;; # new remote branch: check commits not on any remote yet
  esac
  bash scripts/no-console.sh "$base" "$local_sha" || status=1
done
exit $status
