# Warm-standby promotion drill settings. Copy outside the repository and fill in.
# Never commit real URLs or credentials.

# Primary database. Used only to confirm the standby is a different database.
DRILL_PRIMARY_URL=postgres://<user>:<password>@<primary-host>:5432/<database>

# Standby to check and, with --execute, promote. Must be a disposable drill replica.
DRILL_STANDBY_URL=postgres://<user>:<password>@<drill-replica-host>:5432/<database>

# Maximum replay lag, in seconds, before the drill refuses to run.
DRILL_MAX_LAG_SECONDS=30

# Maximum promotion time, in seconds, before the drill reports failure.
DRILL_RTO_BUDGET_SECONDS=300

# Required for --execute. Set it per run, on the command line, not in this file, so a copied
# file can never promote a replica by accident. Value: promote-drill-replica
# DR_DRILL_CONFIRM=
