NODE_ENV=development
PORT=3001
LOG_LEVEL=info
LOG_LEVELS=webhooks:debug
CORS_ALLOWED_ORIGINS=http://localhost:3000
JOBS_ENABLED=true
QUEUE_ENABLED=true
STELLAR_NETWORK=testnet
RATE_LIMIT_FREE=100
RATE_LIMIT_PRO=300
RATE_LIMIT_ENTERPRISE=1000
RATE_LIMIT_WINDOW_MS=900000
COMPRESSION_THRESHOLD=1024

# Token Bucket Rate Limiting
# REDIS_URL=redis://localhost:6379
# RATE_LIMIT_BURST_FREE=10
# RATE_LIMIT_BURST_PRO=50
# RATE_LIMIT_BURST_ENTERPRISE=200
# RATE_LIMIT_REFILL_FREE=1
# RATE_LIMIT_REFILL_PRO=5
# RATE_LIMIT_REFILL_ENTERPRISE=20

# IP Allowlist (comma-separated CIDR ranges)
# IP_ALLOWLIST=10.0.0.0/8,192.168.1.0/24
# IP_ALLOWLIST_ENABLED=false
# IP_ALLOWLIST_BYPASS_ENABLED=false
# IP_ALLOWLIST_BYPASS_EXPIRY_MS=1800000

# Stripe card payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Keep the old secret here during the Stripe dashboard's overlap window.
# STRIPE_WEBHOOK_SECRET_PREVIOUS=whsec_...

# File upload remote URL hardening
# UPLOAD_FETCH_ALLOWED_PORTS=80,443
# UPLOAD_FETCH_MAX_REDIRECTS=5
# UPLOAD_FETCH_TIMEOUT_MS=30000

# Inbound webhook replay receipts (#1472): database (default in production) or memory.
# WEBHOOK_RECEIPT_STORE=database

# Worker service tokens + mTLS (#1474). See docs/security/service-tokens.md.
# SERVICE_AUTH_MODE=optional
# SERVICE_TOKEN_KEYS=[{"kid":"edge-2026-11","service":"agenticpay-edge","publicKey":"-----BEGIN PUBLIC KEY-----...","scopes":["edge:proxy","edge:forward-client-ip","edge:warmup"]}]
# SERVICE_AUTH_CLIENT_CERT_HEADER=x-ssl-client-cert
# SERVICE_AUTH_CLIENT_VERIFY_HEADER=x-ssl-client-verify
# SERVICE_AUTH_TRUSTED_PROXIES=10.0.0.1
